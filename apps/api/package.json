    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.19.25",
    "@types/pg": "8.15.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  }
}
