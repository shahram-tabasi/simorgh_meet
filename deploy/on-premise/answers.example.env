# Unattended install:  sudo ./install.sh --answers answers.env
# (bash syntax; quote values containing spaces). Omitted values use defaults.
PUBLIC_HOST=meet.example.local
LAN_IP=192.168.10.20
HTTPS_PORT=443
HTTP_PORT=80
JVB_PORT=10000
EXTERNAL_GUESTS=0          # 1 = guests from the internet (forward TCP 443 + UDP 10000)
PUBLIC_IP=
ENABLE_TURN=0
TLS_MODE=self-signed       # self-signed | custom
TLS_CERT_FILE=
TLS_KEY_FILE=
ORGANIZATION_NAME="شرکت نمونه"
TZ=Asia/Tehran
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_DISPLAY_NAME="مدیر سامانه"
ADMIN_PASSWORD=            # empty = generated (see /opt/simorgh-meet/credentials.txt)
MEET_AUTH_MODE=internal    # internal | jwt
ENABLE_RECORDING=1
RECORDING_RETENTION_DAYS=365
ENABLE_AI=1
ENABLE_IDP=1
DATA_DIR=/var/lib/simorgh-meet
