# Pinned third-party versions for the offline On-Premise bundle.
# Every artifact here is downloaded ONCE on an internet-connected build machine
# (tools/package/fetch-artifacts.sh + build-images.sh), checksummed, and shipped
# inside the installer. Target servers never need internet access.

SIMORGH_VERSION=0.2.0

# ---- container engine (static binaries, installed by the bundle's installer)
DOCKER_VERSION=29.9.3
DOCKER_STATIC_URL=https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz
COMPOSE_VERSION=v5.1.0
COMPOSE_URL=https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-x86_64

# ---- container images (linux/amd64)
JITSI_IMAGE_VERSION=stable-11031
POSTGRES_IMAGE_TAG=16.15-bookworm
KEYCLOAK_IMAGE_TAG=26.8.2
LLAMACPP_IMAGE_TAG=server-b12282
COTURN_IMAGE_TAG=4.18.0

# ---- speech-to-text model (Persian). See docs/AI-MINUTES-AND-PERSIAN-STT.md.
# Default: Persian fine-tune of Whisper large-v3-turbo (vhdm/whisper-large-fa-v1),
# already converted to CTranslate2 for faster-whisper. Loaded as int8 on CPU.
STT_ENGINE=faster-whisper
STT_MODEL_REPO=parseh/whisper-fa-fast-ct2
STT_MODEL_REVISION=main
# ct2 = download as-is; transformers = download HF checkpoint and convert to CT2.
STT_MODEL_FORMAT=ct2
STT_MODEL_DIR=whisper-fa-turbo-ct2

# ---- minutes LLM (GGUF for llama.cpp, CPU). Qwen3.5-9B: Apache-2.0, strong Persian.
LLM_GGUF_REPO=unsloth/Qwen3.5-9B-GGUF
LLM_GGUF_REVISION=main
# Glob matched against the repository file list; the first match is downloaded.
LLM_GGUF_PATTERN=*Q4_K_M.gguf
LLM_MODEL_FILE=minutes-llm.gguf

# Optional mirror for Hugging Face (e.g. a corporate proxy or https://hf-mirror.com).
HF_ENDPOINT=https://huggingface.co
